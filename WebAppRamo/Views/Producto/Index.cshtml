@model IEnumerable<Datos.cl_Producto>

<div class="row" style="margin-top:20px">
    <div class="col-md-10">
        <h2>Listado de Productos</h2>
    </div>
    <div class="col-md-2 text-right">
        @Html.ActionLink("Nuevo Registro", "Create", null, new { @class = "btn btn-success" })
    </div>
</div>

<table class="table table-hover mt-3">
    <thead class="thead-dark">
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Código</th>
            <th>Precio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Codigo)</td>                
                <td>@Html.DisplayFor(modelItem => item.PrecioUnitario)</td>                
                <td>
                    <button type="button" class="btn btn-warning btn-sm btn-agregar-carrito"
                            title="Añadir al carrito"
                            data-id="@item.Id|@item.PrecioUnitario"
                            data-nombre="@item.Nombre">
                        <i class="fa fa-shopping-cart"></i>
                    </button>
                    |
                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-primary btn-sm" title="Editar">
                        <i class="fa-solid fa-pencil"></i>
                    </a>
                    |
                    <button type="button" class="btn btn-danger btn-sm btn-eliminar"
                            data-id="@item.Id"
                            data-nombre="@item.Nombre @item.Codigo"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEliminar">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalEliminar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @* Asegúrate de que el controlador sea "Clientes" (en plural) *@
            @using (Html.BeginForm("Delete", "Producto", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="IdClienteEliminar" name="id" />
                    <p>¿Estás seguro de que deseas eliminar al producto <strong id="NombreClienteEliminar"></strong>?</p>
                    <small class="text-muted">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar Definitivamente</button>
                </div>
            }
        </div>
    </div>
</div>

<link href="https://netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap-glyphicons.css" rel="stylesheet">

@section Scripts {
    <script>
        $(document).ready(function () {
            console.log("jQuery cargado correctamente"); // Prueba esto en la consola F12

            $(".btn-eliminar").click(function () {
                var id = $(this).data("id");
                var nombre = $(this).data("nombre");

                console.log("ID seleccionado:", id); // Verifica que capture el ID

                $("#IdClienteEliminar").val(id);
                $("#NombreClienteEliminar").text(nombre);
            });

            var contador = 0;

            $(".btn-agregar-carrito").click(function () {
                var btn = $(this);
                var idProducto = btn.data("id").split('|')[0];
                var precio_unitario = btn.data("id").split('|')[1];

                var nombre = $(this).data("nombre");

                var contadorInicializado = $("#cart-count").text();

                // Incrementar contador
                contadorInicializado++;

                // Actualizar visualmente el badge naranja
                $("#cart-count").text(contadorInicializado);

                // Animación simple para que el usuario note el cambio
                $("#cart-count").fadeOut(100).fadeIn(100);

                console.log("Producto añadido: " + nombre);

                // Llamada AJAX al controlador
                $.ajax({
                    url: '@Url.Action("AgregarProducto", "Carrito")', // Acción "AgregarProducto" en "CarritoController"
                    type: 'POST',
                    data: { id: idProducto, precio: precio_unitario },
                    success: function (response) {
                        alert("Producto agregado al carrito");
                        //if (response.success) {
                        //    // Solo si el servidor confirma el guardado, actualizamos la UI
                        //    var nuevoTotal = response.cantidadTotal;

                        //    $("#cart-count").text(nuevoTotal);
                        //    $("#cart-count").fadeOut(100).fadeIn(100);

                        //    console.log("Confirmado: " + nombre + " añadido.");
                        //} else {
                        //    alert("Error: " + response.message);
                        //}
                    },
                    error: function () {
                        alert("No se pudo conectar con el servidor.");
                    }
                });
            });

        });
    </script>
}
