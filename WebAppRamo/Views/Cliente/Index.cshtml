@model IEnumerable<Datos.cl_Cliente>

<div class="row" style="margin-top:20px">
    <div class="col-md-10">
        <h2>Listado de Clientes</h2>
    </div>
    <div class="col-md-2 text-right">
        @Html.ActionLink("Nuevo Registro", "Create", null, new { @class = "btn btn-success" })
    </div>
</div>

<table class="table table-hover mt-3">
    <thead class="thead-dark">
        <tr>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Razón Social</th>
            <th>Email</th>
            <th>Telefono</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombres)</td>
                <td>@Html.DisplayFor(modelItem => item.Apellidos)</td>
                <td>@Html.DisplayFor(modelItem => item.RazonSocial)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-primary btn-sm" }) |
                    @using (Html.BeginForm("Delete", "Clientes", new { id = item.Id }, FormMethod.Post, new { style = "display:inline" }))
                    {
                        <input type="submit" value="Eliminar" class="btn btn-danger btn-sm" onclick="return confirm('¿Borrar registro?');" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>