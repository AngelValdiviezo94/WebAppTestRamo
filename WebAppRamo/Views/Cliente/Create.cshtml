@model Datos.cl_Cliente

@{
    ViewBag.Title = "Nuevo Cliente";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Registrar Nuevo Cliente</h4>
        </div>
        <div class="card-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Nombres, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Nombres, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Nombres, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Apellidos, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Apellidos, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-12 mb-3">
                            @Html.LabelFor(model => model.RazonSocial, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.RazonSocial, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.RazonSocial, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.IdTipoIdentificacion, "Tipo Identificación", new { @class = "control-label fw-bold" })
                            @Html.DropDownListFor(model => model.IdTipoIdentificacion,
                                (IEnumerable<SelectListItem>)ViewBag.TiposIdentificacion,
                                "-- Seleccione Tipo --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.IdTipoIdentificacion, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.NumIdentificacion, "Núm. Identificación (Cédula/RUC)", new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.NumIdentificacion, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.NumIdentificacion, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-4 mb-3">
                            @Html.LabelFor(model => model.Fecha_Nacimiento, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Fecha_Nacimiento, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.Fecha_Nacimiento, "", new { @class = "text-danger" })
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            @Html.LabelFor(model => model.EstadoCivil, "Estado Civil", new { @class = "control-label fw-bold" })
                            @Html.DropDownListFor(model => model.EstadoCivil,
                                (IEnumerable<SelectListItem>)ViewBag.EstadoCivilLst,
                                "-- Seleccione Tipo --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.EstadoCivil, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-4 mb-3">
                            @Html.LabelFor(model => model.TendenciaCompra, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.TendenciaCompra, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.TendenciaCompra, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Email, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Telefono, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-12 mb-4">
                            @Html.LabelFor(model => model.Direccion, new { @class = "control-label fw-bold" })
                            @Html.EditorFor(model => model.Direccion, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Direccion, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group border-top pt-3">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="glyphicon glyphicon-floppy-disk"></i> Guardar
                        </button>
                        @Html.ActionLink("Regresar", "Index", null, new { @class = "btn btn-outline-secondary px-4 ms-2" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}