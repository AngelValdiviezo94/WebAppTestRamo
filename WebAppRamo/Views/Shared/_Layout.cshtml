<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Ecommerce web</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .cart-container {
            position: relative;
            display: inline-block;
            color: white;
            text-decoration: none;
            padding: 15px;
        }

        .cart-icon {
            font-size: 15px;
            color: white;
        }

        .cart-badge {
            position: absolute;
            top: -20px;
            right: 1px;
            background-color: #f08804; /* Color naranja Amazon */
            color: #000;
            border-radius: 50%;
            padding: 3px 2px;
            font-size: 10px;
            font-weight: bold;
        }

        .cart-text {
            font-weight: bold;
            font-size: 14px;
            vertical-align: bottom;
        }

        .cart-container {
            font-family: "Arial", sans-serif;
            max-width: 1000px;
            margin: auto;
        }

        .product-name {
            font-size: 18px;
            font-weight: 700;
            color: #0F1111;
        }

        .current-price {
            font-size: 18px;
            font-weight: 700;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid #FFD814;
            border-radius: 20px;
            background: #fff;
            padding: 2px 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .btn-qty {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 18px;
            padding: 0 8px;
        }

        .qty-value {
            font-weight: bold;
            min-width: 20px;
            text-align: center;
        }

        .action-links a {
            color: #007185;
            text-decoration: none;
            font-size: 12px;
        }

            .action-links a:hover {
                text-decoration: underline;
                color: #C7511F;
            }

        .separator {
            color: #DDD;
            margin: 0 5px;
        }

        .btn-checkout {
            background-color: #FFD814; /* Amarillo Amazon */
            border: none;
            border-radius: 25px; /* Crea el efecto de cápsula redondeada */
            color: #0F1111; /* Texto oscuro/negro */
            padding: 10px 40px;
            font-size: 14px;
            font-family: "Arial", sans-serif;
            cursor: pointer;
            box-shadow: 0 2px 5px 0 rgba(213,217,217,.5); /* Sombra suave */
            transition: background-color 0.2s;
            width: 100%; /* Opcional: para que ocupe el ancho del contenedor */
            max-width: 300px;
        }

            .btn-checkout:hover {
                background-color: #F7CA00; /* Un amarillo ligeramente más oscuro al pasar el mouse */
            }

            .btn-checkout:active {
                background-color: #F0B800;
                box-shadow: none;
            }

        .nav-link.text-white {
            color: #fff !important;
            font-size: 13px;
            font-weight: 500;
            transition: color 0.2s;
        }

            .nav-link.text-white:hover {
                color: #FFD814 !important; /* Color amarillo al pasar el mouse */
            }

        /* Ajuste para que el formulario de logout no rompa el diseño */
        #logoutForm {
            display: inline;
            margin-left: 15px;
        }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("Ecommerce web", "Index", "Producto", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Cliente", "Index", "Cliente", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>

                @*<a href="@Url.Action("Index", "Carrito")" class="cart-container">
            <div style="display: flex; align-items: flex-end;">
                <div style="position: relative;">
                    <i class="fa-solid fa-cart-shopping cart-icon"></i>
                    <span id="cart-count" class="cart-badge">0</span>
                </div>
                <span class="cart-text ms-1">Carrito</span>
            </div>
        </a>*@

                <a href="@Url.Action("Index", "Carrito")" class="cart-container">
                    <div style="display: flex; align-items: flex-end;">
                        <div style="position: relative;">
                            <i class="fa-solid fa-cart-shopping cart-icon"></i>

                            @* Reemplazo del span estático *@
                            @{ Html.RenderAction("CartSummary", "Carrito"); }

                        </div>
                        <span class="cart-text ms-1">Carrito</span>
                    </div>
                </a>
                @if (Request.IsAuthenticated)
                {
                    using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
                    {
                        @Html.AntiForgeryToken()
                        <a href="javascript:document.getElementById('logoutForm').submit()" class="nav-link text-white small">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Cerrar Sesión
                        </a>
                    }
                }
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Ecommerce web</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>

</html>


